(in-package #:cl-mlx)

(define-condition mlx-error (error)
  ((message :initarg :message :reader mlx-error-message))
  (:report (lambda (c s) (write-string (mlx-error-message c) s))))

(defvar *initialized* nil)
(defvar *initialize-lock* (bordeaux-threads:make-lock "MLX initialization"))

(defun initialize (&key library metallib)
  (unless (member :darwin *features*)
    (error 'mlx-error :message "cl-mlx requires macOS with Apple Silicon"))
  (bordeaux-threads:with-lock-held (*initialize-lock*)
    (unless *initialized*
      (let* ((root (asdf:system-source-directory "cl-mlx"))
             (lib (or library (uiop:getenv "CL_MLX_LIBRARY")
                      (merge-pathnames ".native/shim/libclmlx.dylib" root)))
             (metal (or metallib (uiop:getenv "CL_MLX_METALLIB")
                        (merge-pathnames ".native/build/_deps/mlx-build/mlx/backend/metal/kernels/mlx.metallib" root))))
        (unless (and (probe-file lib) (probe-file metal))
          (error 'mlx-error :message "Build native libraries with cl-mlx/build-native.sh or set CL_MLX_LIBRARY and CL_MLX_METALLIB"))
        (cffi:load-foreign-library lib)
        (check-status (%initialize (namestring (pathname metal))))
        (setf *initialized* t))))
  t)

