(in-package #:cl-mlx/gpu)

(cffi:defcfun ("clmlx_kernel_new" %kernel-new) :pointer
  (name :string) (inputs :pointer) (ni :int) (outputs :pointer) (no :int)
  (source :string) (header :string) (atomic :int))
(cffi:defcfun ("clmlx_kernel_free" %kernel-free) :void (kernel :pointer))
(cffi:defcfun ("clmlx_live_kernels" %live-kernels) :size)
(cffi:defcfun ("clmlx_kernel_apply" %kernel-apply) :int
  (kernel :pointer) (inputs :pointer) (ni :int) (outputs :pointer) (no :int)
  (dimensions :pointer) (ranks :pointer) (dtypes :pointer) (grid :pointer) (group :pointer)
  (initialize :int) (init :float) (names :pointer) (kinds :pointer) (values :pointer) (nt :int))

(defun fail (control &rest args)
  (error 'mx:mlx-error :message (apply #'format nil control args)))

(defstruct cached-kernel pointer inputs outputs templates)
(defstruct wrapper-state
  (lock (bordeaux-threads:make-lock "MLX kernel specializations"))
  (cache (make-hash-table :test 'equal)))
(defvar *wrappers* (trivial-garbage:make-weak-hash-table :weakness :key :test 'eq))
(defvar *wrappers-lock* (bordeaux-threads:make-lock "MLX wrappers"))

(defun new-wrapper ()
  (let ((state (make-wrapper-state)))
    (bordeaux-threads:with-lock-held (*wrappers-lock*) (setf (gethash state *wrappers*) t))
    state))

(defun close-cached-kernel (kernel)
  (when (cached-kernel-pointer kernel)
    (trivial-garbage:cancel-finalization kernel)
    (%kernel-free (cached-kernel-pointer kernel))
    (setf (cached-kernel-pointer kernel) nil)))

(defun clear-kernel-cache ()
  "Release cached native kernel handles; existing lazy output graphs remain usable."
  (let ((states (bordeaux-threads:with-lock-held (*wrappers-lock*)
                  (loop for state being the hash-keys of *wrappers* collect state))))
    (dolist (state states)
      (bordeaux-threads:with-lock-held ((wrapper-state-lock state))
        (maphash (lambda (key kernel) (declare (ignore key)) (close-cached-kernel kernel))
                 (wrapper-state-cache state))
        (clrhash (wrapper-state-cache state)))))
  nil)

(defun live-kernel-count () (mx:initialize) (%live-kernels))

(defun parameter-type (parameter)
  (gpu:ir-variable-type (gpu:kernel-parameter-variable parameter)))
(defun parameter-symbol (parameter)
  (gpu:ir-variable-name (gpu:kernel-parameter-variable parameter)))
(defun named (name entries)
  (assoc name entries :test (lambda (a b) (string= (symbol-name a) (symbol-name b)))))

(defun element-type (type)
  (typecase type
    (gpu:pointer-type (element-type (gpu:pointer-type-pointee type)))
    (gpu:vector-type (gpu:vector-type-element type))
    (gpu:atomic-type (gpu:atomic-type-element type))
    (t type)))

(defun mlx-dtype (type)
  (let* ((name (gpu:scalar-type-name (element-type type)))
         (text (string-downcase (symbol-name name))))
    (intern (if (char= (char text 0) #\i) (concatenate 'string "S" (subseq text 1))
                (string-upcase text)) :keyword)))

(defun vector-width (type)
  (let ((element (if (typep type 'gpu:pointer-type) (gpu:pointer-type-pointee type) type)))
    (and (typep element 'gpu:vector-type) (gpu:vector-type-length element))))

(defun checked-templates (templates parameters)
  (let ((seen '()))
    (loop for (name value) in templates
          for parameter = (find name parameters :key #'parameter-symbol
                                :test (lambda (a b) (string= (symbol-name a) (symbol-name b))))
          collect
          (progn
            (unless (and parameter (eq (gpu:kernel-parameter-mode parameter) :value))
              (fail "Template ~a must name a scalar value parameter" name))
            (when (member parameter seen) (fail "Duplicate template ~a" name))
            (push parameter seen)
            (let* ((type (parameter-type parameter))
                   (kind (and (typep type 'gpu:scalar-type) (gpu:scalar-type-kind type))))
              (unless (member kind '(:signed :unsigned :bool))
                (fail "Template ~a requires an integer or boolean scalar" name))
              (unless (if (eq kind :bool) (member value '(t nil)) (gpu::value-p type value)) (fail "Invalid value for template ~a" name))
              (unless (or (eq kind :bool) (typep value '(signed-byte 32)))
                (fail "Template ~a exceeds MLX's signed int32 template range" name))
              (list parameter (if (eq kind :bool) 0 1) (if (eq kind :bool) (if value 1 0) value)))))))

(defmacro with-strings ((pointer strings) &body body)
  (let ((values (gensym)) (allocated (gensym)))
    `(let* ((,values ,strings) (,allocated nil))
       (cffi:with-foreign-object (,pointer :pointer (max 1 (length ,values)))
         (unwind-protect
              (progn
                (loop for string in ,values for i from 0
                      for p = (cffi:foreign-string-alloc string)
                      do (push p ,allocated) (setf (cffi:mem-aref ,pointer :pointer i) p))
                ,@body)
           (mapc #'cffi:foreign-string-free ,allocated))))))

(defun prepare-kernel (kernel templates initialized)
  (let* ((parts (gpu:kernel-parts kernel :metal :initialized-outputs initialized
                                :printer (make-instance 'mlx-printer)))
         (parameters (gpu:kernel-parts-parameters parts))
         (templates (checked-templates templates parameters))
         (inputs (remove-if (lambda (p) (assoc p templates)) (gpu:kernel-parts-inputs parts)))
         (outputs (gpu:kernel-parts-outputs parts))
         (atomic (mapcar (lambda (p) (typep (gpu:pointer-type-pointee (parameter-type p)) 'gpu:atomic-type)) outputs)))
    (when (gpu:kernel-parts-precise-math parts)
      (fail "The pinned MLX C API cannot preserve precise-math"))
    (unless outputs (fail "Custom kernels require at least one output"))
    (when (and (some #'identity atomic) (not (every #'identity atomic)))
      (fail "MLX requires all outputs to be atomic or all non-atomic"))
    (dolist (p inputs)
      (when (and (typep (parameter-type p) 'gpu:pointer-type)
                 (typep (gpu:pointer-type-pointee (parameter-type p)) 'gpu:atomic-type))
        (fail "Read-only atomic inputs are not supported by MLX")))
    (dolist (p parameters) (setf (gpu:kernel-parameter-name p) (wire-name (gpu:kernel-parameter-variable p))))
    (with-strings (in (mapcar #'gpu:kernel-parameter-name inputs))
      (with-strings (out (mapcar #'gpu:kernel-parameter-name outputs))
        (let ((pointer (%kernel-new (format nil "cl_gpu_~a" (gpu::sanitise-name (gpu:ir-kernel-name (gpu:kernel-ir kernel))))
                                    in (length inputs) out (length outputs)
                                    (gpu:kernel-parts-body parts) (gpu:kernel-parts-header parts)
                                    (if (some #'identity atomic) 1 0))))
          (when (cffi:null-pointer-p pointer) (mx::check-status -1))
          (let ((cached (make-cached-kernel :pointer pointer :inputs inputs
                                          :outputs outputs :templates templates)))
            (trivial-garbage:finalize cached (lambda () (%kernel-free pointer)))
            cached))))))

(defun host-array (value type)
  (let* ((width (vector-width type))
         (values (if width (coerce value 'list) (list value)))
         (element (element-type type))
         (dtype (mlx-dtype type)))
    (unless (and (or (not width) (= width (length values)))
                 (every (lambda (x) (if (eq dtype :bool) (member x '(t nil)) (gpu::value-p element x))) values))
      (fail "Value does not match ~a" (gpu:type-description type)))
    (if (member dtype '(:f16 :bf16))
        (mx:astype (host-array value (if width (gpu:parse-type `(gpu:vec gpu:f32 ,width))
                                        (gpu:parse-type 'gpu:f32))) dtype)
        (let ((foreign (ecase dtype
                         (:f32 :float) (:bool :uint8) (:u8 :uint8) (:u16 :uint16) (:u32 :uint32) (:u64 :uint64)
                         (:s8 :int8) (:s16 :int16) (:s32 :int32) (:s64 :int64))))
          (cffi:with-foreign-object (buffer foreign (length values))
            (loop for value in values for i from 0
                  do (setf (cffi:mem-aref buffer foreign i)
                           (cond ((eq dtype :f32) (coerce value 'single-float))
                                 ((eq dtype :bool) (if value 1 0)) (t value))))
            (mx:from-pointer buffer (and width (list width)) :dtype dtype))))))

(defun input-array (parameter value)
  (let* ((type (parameter-type parameter))
         (pointer (typep type 'gpu:pointer-type))
         (array (if (typep value 'mx:array) value
                    (if pointer (fail "Buffer ~a requires an MLX array" (parameter-symbol parameter))
                        (host-array value type))))
         (shape (mx:shape array)) (width (vector-width type)))
    (unless (eq (mx:dtype array) (mlx-dtype type)) (fail "Wrong dtype for ~a" (parameter-symbol parameter)))
    (unless (if pointer
                (and shape (or (not width) (and (>= (length shape) 2) (= (car (last shape)) width))))
                (equal shape (and width (list width))))
      (fail "Wrong array shape for ~a" (parameter-symbol parameter)))
    array))

(defun launch-dimensions (value)
  (let ((dimensions (if (listp value) value (list value))))
    (unless (and (<= 1 (length dimensions) 3)
                 (every (lambda (n) (typep n '(integer 1 2147483647))) dimensions))
      (fail "Launch dimensions require one to three positive int32 values"))
    (append dimensions (make-list (- 3 (length dimensions)) :initial-element 1))))

(defun apply-prepared (cached arguments outputs grid group initialized init)
  (let* ((parameters (cached-kernel-inputs cached))
         (expected (mapcar #'parameter-symbol parameters))
         (given (mapcar #'first arguments)))
    (unless (and (= (length expected) (length given))
                 (every (lambda (name) (named name arguments)) expected))
      (fail "Runtime bindings must name exactly ~s" expected)))
  (unless (and (= (length outputs) (length (cached-kernel-outputs cached)))
               (every (lambda (p) (named (parameter-symbol p) outputs)) (cached-kernel-outputs cached)))
    (fail "Output declarations must name each output exactly once"))
  (let ((mx::*scope-active* t) (mx::*array-scope* nil)
        (success nil) (results nil))
    (unwind-protect
         (let* ((inputs (mapcar (lambda (p) (input-array p (second (named (parameter-symbol p) arguments))))
                               (cached-kernel-inputs cached)))
                (shapes (mapcar (lambda (p)
                                  (let* ((shape (mx::checked-shape (second (named (parameter-symbol p) outputs))))
                                         (width (vector-width (parameter-type p))))
                                    (when (and width (or (< (length shape) 2) (/= (car (last shape)) width)))
                                      (fail "Vector output ~a requires a trailing lane axis" (parameter-symbol p)))
                                    shape)) (cached-kernel-outputs cached)))
                (dtypes (mapcar (lambda (p) (mx::dtype-id (mlx-dtype (parameter-type p)))) (cached-kernel-outputs cached)))
                (templates (cached-kernel-templates cached)))
           (cffi:with-foreign-objects ((in :pointer (max 1 (length inputs))) (out :pointer (length shapes)))
             (loop for array in inputs for i from 0 do (setf (cffi:mem-aref in :pointer i) (mx::pointer array)))
             (dotimes (i (length shapes)) (setf (cffi:mem-aref out :pointer i) (cffi:null-pointer)))
             (mx::with-ints (dims (apply #'append shapes))
               (mx::with-ints (ranks (mapcar #'length shapes))
                 (mx::with-ints (types dtypes)
                   (mx::with-ints (g (launch-dimensions grid))
                     (mx::with-ints (tg (launch-dimensions group))
                       (with-strings (names (mapcar (lambda (x) (gpu:kernel-parameter-name (first x))) templates))
                         (mx::with-ints (kinds (mapcar #'second templates))
                           (mx::with-ints (values (mapcar #'third templates))
                             (mx::check-status (%kernel-apply (cached-kernel-pointer cached) in (length inputs)
                                                             out (length shapes) dims ranks types g tg
                                                             (if initialized 1 0) (coerce (or init 0) 'single-float)
                                                             names kinds values (length templates)))))))))))
             (dotimes (i (length shapes)) (push (mx::wrap (cffi:mem-aref out :pointer i)) results)))
           (setf results (nreverse results))
           (setf results (mapcar (lambda (entry)
                                  (nth (position (first entry) (cached-kernel-outputs cached)
                                                 :key #'parameter-symbol
                                                 :test (lambda (a b) (string= (symbol-name a) (symbol-name b))))
                                       results)) outputs)
                 success t)
           results)
      (dolist (array mx::*array-scope*)
        (unless (and success (member array results)) (mx:release array))))))

(defun call-wrapper (state kernel arguments outputs grid group templates initialized init)
  (mx:initialize)
  (unless (eq (mx:device) :gpu) (fail "Custom Metal kernels require the GPU device"))
  (unless (gpu:gpu-kernel-p kernel) (fail "Expected a cl-gpu kernel"))
  (when (and initialized (not (realp init))) (fail "init-value must be a real number"))
  (bordeaux-threads:with-lock-held ((wrapper-state-lock state))
    (let* ((key (list kernel templates initialized))
           (cached (or (gethash key (wrapper-state-cache state))
                       (setf (gethash key (wrapper-state-cache state))
                             (prepare-kernel kernel templates initialized)))))
      (let ((result (apply-prepared cached arguments outputs grid group initialized init)))
        (when mx::*scope-active* (dolist (array result) (push array mx::*array-scope*)))
        result))))

(defmacro define-kernel (name kernel arguments &key outputs grid group templates (init-value nil initialized))
  "Define NAME with ARGUMENTS, shape/launch expressions and optional scalar templates."
  (unless (and (listp arguments) (every (lambda (x) (and (symbolp x) (not (member x lambda-list-keywords)))) arguments))
    (error "Kernel wrapper arguments must be required parameter names"))
  (unless (and outputs grid group) (error "Kernel wrappers require :outputs, :grid and :group"))
  (let ((state (gensym "STATE")))
    `(let ((,state (new-wrapper)))
       (defun ,name ,arguments
         (call-wrapper ,state ,kernel
                       (list ,@(loop for argument in arguments
                                     unless (find argument templates :key #'first)
                                       collect `(list ',argument ,argument)))
                       (list ,@(loop for (output shape) in outputs collect `(list ',output ,shape)))
                       ,grid ,group
                       (list ,@(loop for (parameter value) in templates collect `(list ',parameter ,value)))
                       ,initialized ,init-value)))))
